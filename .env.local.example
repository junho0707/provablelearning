# Copy to .env.local and fill in real values. See SETUP.md.
# Real values live only on the dev machine's .env.local (never committed).

# --- Required for M1 (content + practice) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Later milestones (unused in M1; copy if you have them) ---
# Billing (M-billing)
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# One price id per SKU (src/lib/pricing.ts) — spec/14 §11
STRIPE_PRICE_FIRST_SESSION=price_...
STRIPE_PRICE_CREDITS_1=price_...
STRIPE_PRICE_CREDITS_2=price_...
STRIPE_PRICE_CREDITS_4=price_...
STRIPE_PRICE_CREDITS_8=price_...

# Cron
CRON_SECRET=your-cron-secret

# Google OAuth + Calendar (configured in Supabase dashboard)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALENDAR_ID=your-class-calendar-id@group.calendar.google.com
GOOGLE_BOOKING_CALENDAR_ID=your-booking-calendar-id@group.calendar.google.com
# Long-lived refresh token for the operator's own Google account (obtained once via a manual
# OAuth consent flow — there's no service account/domain-wide delegation on a personal Gmail).
# Used server-side only, to write booking events to GOOGLE_BOOKING_CALENDAR_ID (TASK-BOOK-003).
GOOGLE_REFRESH_TOKEN=your-google-refresh-token

# Availability template's wall-clock reference (TASK-AVAIL-001). Defaults to America/New_York.
TUTOR_TIMEZONE=America/New_York

# Notifications
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+1...
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=you@yourdomain.com

# NOTE: VERCEL_OIDC_TOKEN is auto-generated by `vercel link`/`vercel dev` — do not hand-copy.
